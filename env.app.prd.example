# Gas e Água Backend - Production Environment
# ==================================================
# Copie este arquivo para .env e preencha com valores reais

# Database (MySQL)
# --------------------------------------------------
MYSQL_ROOT_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_123!
MYSQL_DATABASE=gas_e_agua_prd
MYSQL_USER=gas_e_agua_prd
MYSQL_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_456!

# Application
# --------------------------------------------------
NODE_ENV=production
PORT=3333

# JWT Configuration (REQUIRED - CRITICAL FOR SECURITY)
# --------------------------------------------------
# Generate strong secrets with: openssl rand -hex 64
# NEVER use the same secrets in dev and production!
JWT_SECRET=CHANGE_THIS_TO_STRONG_RANDOM_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_STRONG_RANDOM_SECRET_MIN_64_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis
# --------------------------------------------------
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# Monitoring (Grafana)
# --------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_ABC!
GRAFANA_SECRET_KEY=CHANGE_THIS_STRONG_SECRET_DEF!

# GitHub Container Registry (GHCR)
# --------------------------------------------------
# Injetado automaticamente pelo GitHub Actions
# Você NÃO precisa definir isso manualmente na VPS
# DOCKER_IMAGE=ghcr.io/<owner>/gas-e-agua-backend
# IMAGE_TAG=master-latest

