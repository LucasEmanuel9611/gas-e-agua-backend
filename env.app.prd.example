# Gas e Água Backend - Production Environment
# ==================================================
# Copie este arquivo para .env e preencha com valores reais

# Database (MySQL)
# --------------------------------------------------
MYSQL_ROOT_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_123!
MYSQL_DATABASE=gas_e_agua_prd
MYSQL_USER=gas_e_agua_prd
MYSQL_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_456!

# Database Connection Pool (IMPORTANT FOR PRODUCTION)
# --------------------------------------------------
# Prisma manages connection pooling internally
# Recommended DATABASE_URL format for production:
# mysql://USER:PASSWORD@HOST:PORT/DATABASE?connection_limit=20&pool_timeout=20&connect_timeout=10
# 
# connection_limit: Max number of connections in pool (default: unlimited)
# pool_timeout: Seconds to wait for available connection (default: 10)
# connect_timeout: Seconds to wait for initial connection (default: 5)

# Application
# --------------------------------------------------
NODE_ENV=production
PORT=3333

# Logs
# --------------------------------------------------
# LOG_FORMAT=json faz o console emitir JSON (formato que o Promtail coleta)
# Sem a variável, o log sai colorido e legível para leitura manual
LOG_FORMAT=json

# Timeouts (em millisegundos)
# --------------------------------------------------
# REQUEST_TIMEOUT: Tempo máximo para completar uma requisição HTTP
# DATABASE_QUERY_TIMEOUT: Tempo máximo para completar uma query no banco
REQUEST_TIMEOUT=30000
DATABASE_QUERY_TIMEOUT=15000

# JWT Configuration (REQUIRED - CRITICAL FOR SECURITY)
# --------------------------------------------------
# Generate strong secrets with: openssl rand -hex 64
# NEVER use the same secrets in dev and production!
JWT_SECRET=CHANGE_THIS_TO_STRONG_RANDOM_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_STRONG_RANDOM_SECRET_MIN_64_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis
# --------------------------------------------------
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# Monitoring (Grafana)
# --------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_ABC!
GRAFANA_SECRET_KEY=CHANGE_THIS_STRONG_SECRET_DEF!

# GitHub Container Registry (GHCR)
# --------------------------------------------------
# Injetado automaticamente pelo GitHub Actions
# Você NÃO precisa definir isso manualmente na VPS
# DOCKER_IMAGE=ghcr.io/<owner>/gas-e-agua-backend
# IMAGE_TAG=master-latest

