# Database
MYSQL_ROOT_PASSWORD=senha-root-mysql
MYSQL_DATABASE=gas_e_agua
MYSQL_USER=gas_e_agua
MYSQL_PASSWORD=senha-usuario-mysql

# Application
NODE_ENV=production
PORT=3333
REQUEST_TIMEOUT=30000
DATABASE_QUERY_TIMEOUT=15000

# JWT Configuration (REQUIRED)
JWT_SECRET=change_this_to_strong_random_secret_min_32_chars
JWT_REFRESH_SECRET=change_this_to_another_strong_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# Monitoring (opcional - para integrar com stack existente)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=senha-grafana
GRAFANA_SECRET_KEY=chave-secreta-grafana
