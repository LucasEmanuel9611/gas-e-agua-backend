{
  "name": "gas-e-agua-backend",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node dist/main.js",
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "docker:infra": "docker compose -p gas-e-agua-dev -f docker-compose.dev.yml up -d mysql redis --wait",
    "db:setup": "prisma generate && prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:test:setup": "bash scripts/database/setup-test-db.sh",
    "dev": "npm run docker:infra && npm run db:setup && nest start --watch",
    "test": "npm run db:test:setup && cross-env NODE_ENV=test jest --runInBand --detectOpenHandles",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "prepare": "husky"
  },
  "prisma": {
    "seed": "bash scripts/database/seed.sh"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/schedule": "^6.1.3",
    "@prisma/client": "^5.9.1",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/morgan": "^1.9.9",
    "@types/ms": "^2.1.0",
    "bcrypt": "^5.1.0",
    "bullmq": "^5.61.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cors": "^2.8.5",
    "csv-parse": "^5.3.6",
    "dayjs": "^1.11.7",
    "dotenv": "^16.0.3",
    "expo-server-sdk": "^3.7.0",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "fast-redact": "^3.5.0",
    "handlebars": "^4.7.7",
    "husky": "^9.1.7",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.0",
    "mime": "^3.0.0",
    "morgan": "^1.10.0",
    "ms": "^2.1.3",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pg": "^8.10.0",
    "prisma": "^5.9.1",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^2.4.1",
    "redis": "^4.6.6",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.2",
    "sqlite3": "^5.1.7",
    "supertest": "^7.1.1",
    "swagger-ui-express": "^4.6.2",
    "ts-jest": "^29.2.5",
    "uuid": "^9.0.0",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.1",
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.15",
    "@types/jest": "^29.5.5",
    "@types/multer": "^1.4.7",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.3",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^5.48.0",
    "@typescript-eslint/parser": "^5.48.0",
    "cross-env": "^7.0.3",
    "eslint": "^7.21.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-import-resolver-typescript": "^3.5.2",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-import-helpers": "^1.3.1",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^29.7.0",
    "prettier": "^2.8.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "compilerOptions": {
    "module": "esnext",
    "target": "es2022",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true
  }
}
