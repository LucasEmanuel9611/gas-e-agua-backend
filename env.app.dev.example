# Gas e Água Backend - Development Environment
# ==================================================
# Copie este arquivo para .env.dev e preencha com valores reais

# Database (MySQL)
# --------------------------------------------------
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=gas_e_agua_dev
MYSQL_USER=gas_e_agua_dev
MYSQL_PASSWORD=password

# Database Connection Pool (MySQL via Prisma)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?connection_limit=20&pool_timeout=20&connect_timeout=10
# Connection pool managed by Prisma automatically

# Application
# --------------------------------------------------
NODE_ENV=development
PORT=3333

# Timeouts (em millisegundos)
# --------------------------------------------------
REQUEST_TIMEOUT=30000
DATABASE_QUERY_TIMEOUT=15000

# JWT Configuration (REQUIRED)
# --------------------------------------------------
# Generate strong secrets with: openssl rand -hex 32
JWT_SECRET=change_this_to_strong_random_secret_min_32_chars
JWT_REFRESH_SECRET=change_this_to_another_strong_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis
# --------------------------------------------------
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# Monitoring (Grafana)
# --------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123
GRAFANA_SECRET_KEY=grafana_secret_key_dev

# GitHub Container Registry (GHCR)
# --------------------------------------------------
# Injetado automaticamente pelo GitHub Actions
# Você NÃO precisa definir isso localmente
# DOCKER_IMAGE=ghcr.io/<owner>/gas-e-agua-backend
# IMAGE_TAG=develop-latest

